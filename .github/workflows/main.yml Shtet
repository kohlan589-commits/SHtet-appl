name: Build SHtet App APK

on:
  push:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v3
        with:
          distribution: 'zulu'
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.19.x'
          channel: 'stable'
          cache: true

      # Project တွင်းရှိ Dependencies များကို ယူခြင်း (Working Directory သတ်မှတ်ခြင်း)
      - name: Install dependencies
        run: flutter pub get

      # Release APK ဖိုင် တည်ဆောက်ခြင်း
      - name: Build APK
        run: flutter build apk --release

      - uses: actions/upload-artifact@v4
        with:
          name: app-release
          path: build/app/outputs/flutter-apk/app-release.apk
